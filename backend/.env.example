# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME="AI Fraud & Risk Detection Platform"
ENVIRONMENT=development
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fraud_user:fraud_pass@localhost:5432/fraud_db
DATABASE_SYNC_URL=postgresql+psycopg2://fraud_user:fraud_pass@localhost:5432/fraud_db

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT (RS256) ────────────────────────────────────────────────────────────────
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the full PEM content as a single-line value (replace newlines with \n)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n<paste here>\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<paste here>\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Field Encryption ──────────────────────────────────────────────────────────
# Generate with Python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
FIELD_ENCRYPTION_KEY=<your-32-byte-base64-key>

# ── External Module URLs ──────────────────────────────────────────────────────
MODULE2_BASE_URL=http://localhost:8001
MODULE3_BASE_URL=http://localhost:8002

# ── Rate Limiting ─────────────────────────────────────────────────────────────
EXTERNAL_API_RATE_LIMIT=60/minute

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
